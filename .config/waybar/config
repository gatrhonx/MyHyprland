{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 40,
    
    // Posiciones de los módulos en la barra
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "cpu", "memory", "battery"],

    // Configuración de los módulos nativos de Hyprland (Pelotitas)
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "*": 2 // Solo dejamos el 1 fijo para que la barra nunca esté vacía
        }
},
        "format-icons": {
            "active": "",
            "default": "",
            "empty": "",
            "urgent": ""
        }
    },

    // Módulo de Reloj
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    
    // Modulo de audio pulseaudio
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟 ",
        "format-icons": ["󰕿 ", "󰖀 ", "󰕾 "],
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    // Módulo de CPU
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    // Módulo de Memoria RAM
    "memory": {
        "format": "  {}%"
    },

    // Módulo de Batería
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 1
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    // Módulo de Bluetooth
    "bluetooth": {
        "format": "{status} ",
        "format-connected": "{device_alias} ",
        "format-connected-battery": "{device_alias} {device_battery_percentage}% ",
        "on-click": "blueman-manager"
    },

    // Módulo de Red
    "network": {
        "format-wifi": "{essid} {icon}",
        "format-ethernet": "{ipaddr}/{cidr} 󰈀 ",
        "format-disconnected": "Disconnected ⚠",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "on-click": "kitty -e nmtui"
    }
}
